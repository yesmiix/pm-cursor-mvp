# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Embeddings для One-doc RAG (страницы /kb и /ask)
EMBEDDING_MODEL=text-embedding-3-small

# Vercel KV (опционально; для продакшена нужен KV или Supabase)
# Без KV данные хранятся in-memory (только для локальной разработки)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
